# Copy to .env in this directory (ATG-Dashboard/). Loaded via python-decouple.

# Django
SECRET_KEY=your-django-secret-key



# PostgreSQL
NAME=atg_dashboard
DB_USER=postgres
PASSWORD=your-db-password
HOST=localhost

# Frontend URL for survey/form links (defaults to http://localhost:8080 if unset)
FRONTEND_BASE_URL=http://localhost:8080

# Go High Level (Lead Connector) OAuth
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECTED_URI=
SCOPE=

# Backend base URL used for OAuth redirect callbacks
BASE_URI=http://localhost:8000
